# Vercel + Postgres 서버 환경변수. 실제 값은 저장소에 커밋하지 않습니다.
DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"
PORTAL_AUTH_SECRET=""

# 실제 계약 및 승인 템플릿 준비 후 설정합니다. 기본값은 발송 비활성입니다.
ALIGO_ENABLED="false"
ALIGO_API_KEY=""
ALIGO_USER_ID=""
ALIGO_SENDER_KEY=""
ALIGO_SENDER=""
ALIGO_TEMPLATE_CODE=""
# 승인된 템플릿 전문. 지원 변수: #{학생명}, #{도서명}, #{점수}, #{생각담기}, #{첨삭}
ALIGO_REPORT_TEMPLATE=""

# 계약한 업체의 HTTPS 결제 안내 주소. 비어 있으면 결제 진입이 비활성입니다.
# 주소 설정만으로 자동 과금·정기결제·웹훅 처리가 활성화되지는 않습니다.
PAYMENT_PORTAL_URL=""

# 기존 계정 비밀번호 초기 설정 시에만 로컬 환경변수로 지정합니다.
# PORTAL_SETUP_USERNAME=""
# PORTAL_SETUP_PASSWORD=""

