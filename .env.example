# ==============================================================
# Vercel Prisma Postgres 환경 변수 (.env.example)
# ==============================================================
# Vercel Storage 대시보드에서 데이터베이스 클릭 후
# ".env.local" 탭의 DATABASE_URL을 복사하여 .env에 붙여넣어 주세요.

DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_api_key_here"
