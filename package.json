{
  "name": "nano-bookshelf",
  "version": "1.0.0",
  "description": "나노의책장 - B2B 독서논술 학원 및 원생 관리 시스템 (Supabase + Prisma)",
  "main": "index.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "db:backup": "tsx scripts/backup.ts",
    "build": "node scripts/prepare-portal.cjs && node scripts/build-portal.cjs",
    "test:ux": "node --test scripts/preview-ux.test.cjs scripts/portal-api.test.cjs scripts/portal-operations.test.cjs scripts/portfolio-workflow.test.cjs scripts/ranking-ui.test.cjs",
    "portal:password": "tsx scripts/set-portal-password.ts",
    "typecheck:portal": "tsc -p tsconfig.portal.json",
    "migrate:dry-run": "tsx scripts/migrate/full-safe-migration.ts --dry-run",
    "migrate:all": "tsx scripts/migrate/full-safe-migration.ts",
    "migrate:verify": "tsx scripts/migrate/verify-migration-integrity.ts",
    "points:recalc": "tsx scripts/recalculate_points_by_policy.ts",
    "r2:dry-run": "tsx scripts/r2/sync-media-to-r2.ts --dry-run",
    "r2:sync": "tsx scripts/r2/sync-media-to-r2.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true
  },
  "keywords": [
    "nano-bookshelf",
    "prisma",
    "supabase",
    "vercel"
  ],
  "author": "Nano Bookshelf",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.45.6",
    "dotenv": "^16.4.5",
    "undici": "^8.12.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
