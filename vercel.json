{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "crons": [{ "path": "/api/dispatch-reconcile", "schedule": "0 0 * * *" }],
  "functions": { "api/dispatch-reconcile.ts": { "maxDuration": 300 } },
  "headers": [
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|jfif|gif|ico|webp|svg|woff2|ttf|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
