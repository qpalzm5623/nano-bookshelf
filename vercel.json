{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "crons": [
    { "path": "/api/dispatch-reconcile", "schedule": "0 0 * * *" },
    { "path": "/api/grade-promotion", "schedule": "0 15 31 12 *" }
  ],
  "functions": {
    "api/dispatch-reconcile.ts": { "maxDuration": 300 },
    "api/grade-promotion.ts": { "maxDuration": 60 },
    "api/worksheet-ai.ts": { "maxDuration": 60 },
    "api/portfolio-ai.ts": { "maxDuration": 60 },
    "api/bootstrap.ts": { "maxDuration": 60 },
    "api/manage.ts": { "maxDuration": 60 },
    "api/portal.ts": { "maxDuration": 60 },
    "api/billing.ts": { "maxDuration": 60 },
    "api/services.ts": { "maxDuration": 60 },
    "api/activity.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|jfif|gif|ico|webp|svg|woff2|ttf|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
